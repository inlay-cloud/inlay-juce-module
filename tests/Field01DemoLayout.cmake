function(require_file relative_path)
    if(NOT EXISTS "${PROJECT_ROOT}/${relative_path}")
        message(FATAL_ERROR "Expected demo file is missing: ${relative_path}")
    endif()
endfunction()

function(require_text relative_path expected_text)
    file(READ "${PROJECT_ROOT}/${relative_path}" contents)
    string(FIND "${contents}" "${expected_text}" match_offset)
    if(match_offset EQUAL -1)
        message(FATAL_ERROR "${relative_path} does not contain: ${expected_text}")
    endif()
endfunction()

